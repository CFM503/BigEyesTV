<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused state on Android TV: Large high-contrast thumb with glow border -->
    <item android:state_focused="true">
        <shape android:shape="oval">
            <size android:width="26dp" android:height="26dp" />
            <solid android:color="#2196F3" />
            <stroke android:width="3.5dp" android:color="#FFFFFF" />
        </shape>
    </item>
    <!-- Pressed state -->
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <size android:width="26dp" android:height="26dp" />
            <solid android:color="#64B5F6" />
            <stroke android:width="3.5dp" android:color="#FFFFFF" />
        </shape>
    </item>
    <!-- Normal state -->
    <item>
        <shape android:shape="oval">
            <size android:width="18dp" android:height="18dp" />
            <solid android:color="#FFFFFF" />
            <stroke android:width="2dp" android:color="#2196F3" />
        </shape>
    </item>
</selector>
